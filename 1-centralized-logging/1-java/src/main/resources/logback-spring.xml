<!-- logback-spring.xml — Loki4j appender ships structured logs with labels to Loki. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <!-- LOKI_URL is injected from the environment (overridable per deploy env). -->
            <url>${LOKI_URL:-http://loki:3100}/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <!-- Low-cardinality labels describe the SOURCE, not per-request data. -->
                <pattern>app=${LOG_APP_NAME:-logging-api},env=${LOG_ENV:-lab},level=%level</pattern>
            </label>
            <message>
                <pattern>level=%level %msg</pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
